# Backend port (default: 9080)
PORT=9080

# Redis connection URL
REDIS_URL=redis://redis:6379

# SQLite database path
DATABASE_URL=sqlite:///data/devharness.db

# Beads shared Dolt remote (file:// URL pointing to <project-root>/.beads-remote)
# Run scripts/init-beads-remote.sh to create this remote.
BEADS_REMOTE_PATH=file:///path/to/dev-harness/.beads-remote
