# Backend port (default: 9080)
PORT=9080

# Redis connection URL
REDIS_URL=redis://redis:6379

# SQLite database path
DATABASE_URL=sqlite:///data/devharness.db

# Host directory containing your git projects. This is bind-mounted into the
# backend container at the SAME absolute path, so the container and the
# host-side executor resolve worktree paths identically. (default: /home/henry/Projects)
PROJECTS_DIR=/home/henry/Projects

# HOME directory inside the backend container. Used by git and tooling.
# (default: /home/henry)
HOME_DIR=/home/henry
